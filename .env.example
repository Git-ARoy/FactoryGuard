# ==============================================================================
# FactoryGuard - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: The application supports a zero-dependency LOCAL MODE.
# If COSMOS_ENDPOINT or STORAGE_ACCOUNT_URL are omitted, FactoryGuard automatically
# uses high-fidelity in-memory repositories pre-seeded with realistic industrial data.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_VERSION=1.0.0
PORT=3000

# Azure Cosmos DB for NoSQL
# (Leave empty to use built-in local persistent in-memory repository)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=factoryguard
COSMOS_MACHINES_CONTAINER=machines
COSMOS_TELEMETRY_CONTAINER=telemetry
COSMOS_INCIDENTS_CONTAINER=incidents
COSMOS_DOCUMENTS_CONTAINER=documents

# Azure Blob Storage
# (Leave empty to use built-in local document storage fallback)
STORAGE_ACCOUNT_URL=
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER_NAME=documents

# Azure Functions Backend API
# (If specified, Next.js API proxy forwards event operations to Azure Functions.
#  If left blank, Next.js handles domain operations directly via shared services.)
FUNCTION_BASE_URL=
FUNCTION_INTERNAL_SECRET=

# Azure Application Insights (Azure Monitor)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Workshop Configuration
SIMULATION_DEFAULT_MACHINE_ID=CNC-02
