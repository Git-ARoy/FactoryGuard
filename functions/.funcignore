# Azure Functions deployment ignore file
# Excludes local node_modules, secrets, and developer tooling from the deployment zip

# NEVER package local node_modules - Azure remote build installs clean production dependencies
node_modules/

# Local settings and environment secrets
local.settings.json
.env
.env.*
*.env

# Version control and editor
.git/
.gitignore
.vscode/
.DS_Store

# Tests, coverage, and build caches
tests/
coverage/
*.log
*.tsbuildinfo
.nyc_output/
